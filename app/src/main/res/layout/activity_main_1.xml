
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:orientation="vertical" android:padding="16dp"
 android:layout_width="match_parent" android:layout_height="match_parent">
 <TextView android:text="Bloqueio de Chamada Sidicley" android:textSize="24sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchAtivo" android:text="Bloqueio Ativo (só agenda libera)" android:checked="true" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <com.google.android.material.card.MaterialCardView android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <LinearLayout android:orientation="vertical" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
   <TextView android:text="Modo de bloqueio:" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   <RadioGroup android:id="@+id/rgModo" android:layout_width="match_parent" android:layout_height="wrap_content">
     <RadioButton android:id="@+id/rbNaoContatos" android:text="Bloquear quem NÃO está na agenda (recomendado)" android:checked="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
     <RadioButton android:id="@+id/rbListaBranca" android:text="Só permitir lista branca (agenda + meus números)" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
     <RadioButton android:id="@+id/rbListaNegra" android:text="Bloquear só lista negra" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   </RadioGroup>
  </LinearLayout>
 </com.google.android.material.card.MaterialCardView>
 <LinearLayout android:orientation="horizontal" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
   <com.google.android.material.textfield.TextInputEditText android:id="@+id/etNumero" android:hint="Adicionar número ex: 81999999999" android:inputType="phone" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/btnAddBranca" android:text="Lista Branca" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/btnAddPreta" android:text="Lista Negra" android:style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 </LinearLayout>
 <TextView android:text="Chamadas Bloqueadas" android:textStyle="bold" android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvBloqueadas" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/btnPedirPermissoes" android:text="Conceder Permissões de Chamada" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
